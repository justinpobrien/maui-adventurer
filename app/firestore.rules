rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The site only reads Firestore at build time via the Admin SDK, which
    // bypasses these rules. No client ever talks to Firestore directly, so
    // client access is denied entirely.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
