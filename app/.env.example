# Used by both `npm run sync-content` (writes) and `npm run build` (reads
# via Astro's server-side data fetch at build time).

# Option A: paste a full service account JSON as a single-line string.
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account",...}'

# Option B: point at a service account file instead (leave FIREBASE_SERVICE_ACCOUNT unset).
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Required when using Option B, or when relying on Application Default
# Credentials in a deployed environment.
FIREBASE_PROJECT_ID=

# For local dev/testing against the Firestore emulator instead of production:
# FIRESTORE_EMULATOR_HOST=localhost:8080
